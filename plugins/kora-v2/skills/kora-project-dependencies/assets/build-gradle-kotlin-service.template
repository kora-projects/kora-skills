// Kora 2.0 Kotlin Service - build.gradle.kts template
// HTTP server with JSON and Micrometer metrics.
//
// Kotlin shape: BOM straight on `implementation`, explicit version on `ksp`, and NO koraBom
// configuration / extendsFrom. That is deliberate - the Java shape does not apply here.

plugins {
    id("application")
    id("jacoco")
    kotlin("jvm") version "2.4.20"
    id("com.google.devtools.ksp") version "2.3.12"
}

repositories {
    mavenCentral()
    // io.koraframework:kora-bom:2.0.0.RC2 is on Maven Central; nothing else is needed.
    // Only the 2.0.0-SNAPSHOT development line also needs:
    // maven { url = uri("https://central.sonatype.com/repository/maven-snapshots") }
}

dependencies {
    implementation(platform("io.koraframework:kora-bom:${property("koraVersion")}"))
    ksp("io.koraframework:symbol-processors:${property("koraVersion")}")

    // Core modules
    implementation("io.koraframework:logging-logback")
    implementation("io.koraframework:config-hocon")
    implementation("io.koraframework:json-common")

    // HTTP server (Undertow) - UndertowPublicHttpServerModule
    implementation("io.koraframework:http-server-undertow")

    // Telemetry - metrics default to disabled, enable them in application.conf:
    //   httpServer { telemetry.metrics.enabled = true }
    implementation("io.koraframework:micrometer-module")

    // Testing. test-junit5 declares MockK compileOnly - bring your own, new enough for Java 25.
    testImplementation("io.koraframework:test-junit5")
    testImplementation("io.mockk:mockk:1.14.11")
    testImplementation("org.skyscreamer:jsonassert:1.5.1")

    // Add kspTest only when test sources generate a Kora graph of their own:
    // kspTest("io.koraframework:symbol-processors:${property("koraVersion")}")
}

kotlin {
    jvmToolchain {
        languageVersion.set(JavaLanguageVersion.of(25))
        vendor.set(JvmVendorSpec.ADOPTIUM)
    }
}

application {
    applicationName = "application"
    mainClass.set("com.example.app.ApplicationKt")
    applicationDefaultJvmArgs = listOf("-Dfile.encoding=UTF-8")
}

tasks.test {
    useJUnitPlatform()
    testLogging {
        showStandardStreams = true
        events("passed", "skipped", "failed")
        exceptionFormat = org.gradle.api.tasks.testing.logging.TestExceptionFormat.FULL
    }
}
