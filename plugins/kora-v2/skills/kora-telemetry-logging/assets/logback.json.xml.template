<?xml version="1.0" encoding="UTF-8"?>
<!--
  src/main/resources/logback.xml for one JSON object per line.
  Needs implementation "io.koraframework:logging-logback-json".

  Without any logback.xml the same encoder is selected automatically when logging-logback-json is
  on the classpath (override with -Dkora.logging.encoder=text|pretty|json or KORA_LOGGING_ENCODER).
  Keep this file only when you need <maskField>, custom <writer> parts or appender tuning:
  a configuration file always wins over that automatic selection.

  maskField replaces every JSON field with that name ("***"), at any depth of the record. It does
  not look inside string values such as an HTTP body or headers string.

  Logger levels are configured in application.conf under logging.levels.
-->
<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="io.koraframework.logging.logback.json.JsonRecordEncoder">
            <maskField>password</maskField>
            <maskField>token</maskField>
        </encoder>
    </appender>

    <appender name="ASYNC" class="io.koraframework.logging.logback.KoraAsyncAppender">
        <appender-ref ref="STDOUT"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
