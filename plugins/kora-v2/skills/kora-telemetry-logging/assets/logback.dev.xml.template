<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local development: a colourised pattern encoder, easier to read than the structured text format.

  Trade-off: a <pattern> encoder does not understand StructuredArgument, so structured values,
  Kora MDC entries and traceId/spanId will NOT appear. %X{} reads the SLF4J MDC only. Switch back
  to io.koraframework.logging.logback.text.ConsoleTextRecordEncoder (see logback.xml.template) when
  you need them. Without any logback.xml, -Dkora.logging.encoder=pretty gives coloured Kora text
  output that keeps them.
-->
<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%cyan(%d{HH:mm:ss.SSS}) %highlight(%-5level) [%thread] %logger{36} [requestId=%X{requestId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="io.koraframework.logging.logback.KoraAsyncAppender">
        <appender-ref ref="STDOUT"/>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
