<?xml version="1.0" encoding="UTF-8"?>
<!--
  src/main/resources/logback.xml — the shape used by every migrated Kora 2.0 example app.

  io.koraframework.logging.logback.text.ConsoleTextRecordEncoder is what renders traceId/spanId, Kora MDC entries and structured
  arguments; a plain <pattern> encoder drops all of them.

  KoraAsyncAppender is what produces the KoraLoggingEvent those fields live on — it is required,
  not an optimisation. Logback's stock AsyncAppender does not substitute for it.

  Logger levels are configured in application.conf under logging.levels: LoggingLevelRefresher
  resets every Logback logger at graph start, so <logger> elements here would be discarded.
-->
<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="io.koraframework.logging.logback.text.ConsoleTextRecordEncoder"/>
    </appender>

    <!-- KoraAsyncAppender extends Logback AsyncAppenderBase. It accepts queueSize (Kora default 512),
         neverBlock (Kora default true: a full queue drops events), maxFlushTime (1000 ms) and
         discardingThreshold (default queueSize/5: below that many free slots TRACE/DEBUG/INFO are
         dropped, WARN/ERROR kept; 0 never drops by level). -->
    <appender name="ASYNC" class="io.koraframework.logging.logback.KoraAsyncAppender">
        <appender-ref ref="STDOUT"/>
        <queueSize>8192</queueSize>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
