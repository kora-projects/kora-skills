plugins {
    id "java"
    id "application"
}

// Kora 2.0 requires JVM 25 — artifacts are compiled to class-file major version 69.
java {
    toolchain { languageVersion = JavaLanguageVersion.of(25) }
}

repositories {
    mavenCentral()
}

// io.koraframework:kora-bom aligns every Kora artifact version.
// Put koraVersion=2.0.0.RC2 in gradle.properties; never pin a version on an individual artifact.
configurations {
    koraBom
    annotationProcessor.extendsFrom(koraBom)
    compileOnly.extendsFrom(koraBom)
    implementation.extendsFrom(koraBom)
    testImplementation.extendsFrom(koraBom)
    testAnnotationProcessor.extendsFrom(koraBom)
}

dependencies {
    koraBom platform("io.koraframework:kora-bom:$koraVersion")

    // MANDATORY — Kotlin uses ksp "io.koraframework:symbol-processors" instead.
    annotationProcessor "io.koraframework:annotation-processors"

    // SLF4J + Logback backend. Transitively brings logging-common (MDC, StructuredArgument,
    // masking, @Log/@Mdc), json-common and the OpenTelemetry API that KoraAsyncAppender uses.
    // For one JSON object per line use "io.koraframework:logging-logback-json" instead
    // (it depends on logging-logback and is picked automatically when there is no logback.xml).
    implementation "io.koraframework:logging-logback"

    // MANDATORY alongside logging: LoggingModule reads the `logging` config section.
    implementation "io.koraframework:config-hocon"   // or "io.koraframework:config-yaml"
}
