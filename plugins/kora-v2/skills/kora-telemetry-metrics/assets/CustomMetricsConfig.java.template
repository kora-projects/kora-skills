package ${package};

import io.koraframework.common.annotation.Module;
import io.koraframework.micrometer.module.PrometheusMeterRegistryInitializer;
import io.micrometer.core.instrument.config.MeterFilter;

/**
 * Metrics customization module (Kora 2.0).
 *
 * For common tags you need no initializer: use metrics.tags in application.conf or a
 * MetricsTagsProvider component (see AppMetricsTagsProvider.java.template). Declare your own
 * PrometheusMeterRegistryInitializer only for other registry.config() settings -- meter
 * filters, deny rules, naming conventions.
 *
 * MetricsModule collects every PrometheusMeterRegistryInitializer with
 * All&lt;PrometheusMeterRegistryInitializer&gt; and applies them inside
 * PrometheusMeterRegistryWrapper.init(), BEFORE the JVM binders are bound and before
 * kora.up is registered.
 *
 * MetricsModule's common-tags initializer is not a @DefaultComponent (since 2.0.0.RC2), so it
 * stays in that All&lt;&gt; next to this one: metrics.tags and MetricsTagsProvider keep applying.
 * Do not re-merge them here.
 *
 * PrometheusMeterRegistryInitializer extends
 * Function&lt;PrometheusMeterRegistry, PrometheusMeterRegistry&gt;, so it MUST return the
 * registry.
 */
@Module
public interface CustomMetricsConfig {

    default PrometheusMeterRegistryInitializer meterFiltersInit() {
        return registry -> {
            registry.config().meterFilter(MeterFilter.denyNameStartsWith("jvm.buffer"));
            return registry;
        };
    }
}
