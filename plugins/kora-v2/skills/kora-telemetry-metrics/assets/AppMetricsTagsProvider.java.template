package ${package};

import io.koraframework.common.annotation.Component;
import io.koraframework.micrometer.module.MetricsTagsProvider;

import java.util.Map;
import java.util.Objects;

/**
 * Common tags computed at startup (Kora 2.0).
 *
 * MetricsModule collects every MetricsTagsProvider with All&lt;MetricsTagsProvider&gt;, merges
 * their tags with metrics.tags from application.conf and installs the result as one global
 * MeterFilter.commonTags(...) -- every meter in the registry gets them, JVM meters and kora.up
 * included. On a key conflict metrics.tags wins.
 *
 * tags() is called once while the graph is built; later changes are not picked up. Keep the
 * values bounded -- they multiply onto every time series.
 */
@Component
public final class AppMetricsTagsProvider implements MetricsTagsProvider {

    private final Map<String, String> tags;

    public AppMetricsTagsProvider() {
        this.tags = Map.of(
                "region", System.getenv().getOrDefault("REGION", "unknown"),
                "app.version", Objects.requireNonNullElse(getClass().getPackage().getImplementationVersion(), "unknown"));
    }

    @Override
    public Map<String, String> tags() {
        return this.tags;
    }
}
