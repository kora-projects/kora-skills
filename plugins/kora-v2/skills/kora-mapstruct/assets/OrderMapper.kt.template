// Kora 2.0 — Konvert mapper (Kotlin).
//
// Kotlin's mapping path in Kora 2.0 is Konvert, never MapStruct: MapStruct is a javac annotation
// processor and Kora's Kotlin processors run in KSP. `konvert-ksp-extension` (already inside
// `io.koraframework:symbol-processors`) finds this @Konverter interface, looks up the
// Konvert-generated `object OrderMapperImpl`, and binds it into the graph as a singleton.
// Inject `OrderMapper` by constructor. No @Component.
//
// Requires, in build.gradle.kts:
//   ksp("io.koraframework:symbol-processors:${property("koraVersion")}")
//   ksp("io.mcarle:konvert:4.5.1")
//   implementation("io.mcarle:konvert-api:4.5.1")
//
// Replace `com.example.app.mapper` with your package.

package com.example.app.mapper

import com.example.app.dto.CreateOrderDto
import com.example.app.dto.OrderDto
import com.example.app.entity.Order
import com.example.app.entity.OrderStatus
import io.koraframework.common.annotation.Component
import io.mcarle.konvert.api.Konverter
import java.time.OffsetDateTime
import java.util.UUID

// @Konverter accepts an INTERFACE only — an abstract class will not be picked up.
// Konvert generates a top-level `object OrderMapperImpl`, dropping any enclosing type name,
// so keep @Konverter interfaces top-level and uniquely named within their package.
@Konverter
interface OrderMapper {

    // Properties that match by name and type need no configuration.
    fun toDto(entity: Order): OrderDto
}

// Per-field customisation — renames, computed values, per-property converters — is Konvert's own
// API (@Konvert, @Mapping and friends): https://mcarleio.github.io/konvert/
//
// The extension binds the generated object with an EMPTY dependency list, so a @Konverter mapper
// can never take graph dependencies. Generated identifiers, timestamps, PATCH-style updates onto a
// `val` data class, and anything that needs a component belong in a regular @Component that
// delegates to the mapper:

@Component
class OrderAssembler(
    private val mapper: OrderMapper,
) {

    // Plain synchronous Kotlin; Kora 2.0 has no suspend or reactive contracts.
    fun newOrder(dto: CreateOrderDto): Order = Order(
        id = UUID.randomUUID(),
        createdAt = OffsetDateTime.now(),
        status = OrderStatus.PENDING,
        customerId = dto.customerId,
        lines = dto.lines,
    )

    fun toDto(order: Order): OrderDto = mapper.toDto(order)
}

// Usage — the assembler is an ordinary constructor dependency:
//
//   @Component
//   class OrdersService(
//       private val assembler: OrderAssembler,
//       private val repo: OrderRepository,
//   ) {
//       fun create(body: CreateOrderDto): OrderDto {
//           val saved = repo.save(assembler.newOrder(body))
//           return assembler.toDto(saved)
//       }
//   }
