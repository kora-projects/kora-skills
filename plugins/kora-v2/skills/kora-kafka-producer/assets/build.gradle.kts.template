// Kora 2.x — single-module Kotlin service publishing to Kafka.
// Kora 2.0 artifacts are built for Java 25; the toolchain below is the minimum, not a preference.

plugins {
    kotlin("jvm") version "2.4.20"
    id("com.google.devtools.ksp") version "2.3.12"
    id("application")
}

repositories {
    mavenCentral()
}

// koraVersion=2.0.0.RC2 lives in gradle.properties
val koraVersion: String by project

dependencies {
    implementation(platform("io.koraframework:kora-bom:$koraVersion"))

    // Mandatory. The ksp configuration is NOT covered by the BOM platform, so the processor
    // carries an explicit version. Without it nothing is generated and the only symptom is
    // "unresolved reference: ApplicationGraph".
    ksp("io.koraframework:symbol-processors:$koraVersion")

    // Brings org.apache.kafka:kafka-clients 4.3.1 transitively
    implementation("io.koraframework:kafka")

    // Only needed for @Json payloads (artifact was ru.tinkoff.kora:json-module in 1.x)
    implementation("io.koraframework:json-common")

    implementation("io.koraframework:config-hocon")
    implementation("io.koraframework:logging-logback")

    // Required ONLY if a publisher declares a suspend or Deferred send method: the generated
    // $X_Impl.kt calls kotlinx.coroutines.future.await / asDeferred, and io.koraframework:kafka
    // does not bring coroutines. Symptom without it: "Unresolved reference 'kotlinx'" in a file
    // under build/generated/ksp.
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-jdk8:1.10.2")

    kspTest("io.koraframework:symbol-processors:$koraVersion")
    testImplementation("io.koraframework:test-junit5")

    // Testcontainers 2.x renamed every module: org.testcontainers:kafka no longer exists.
    // The container is started from a static initializer in the tests, so the JUnit
    // integration module (org.testcontainers:testcontainers-junit-jupiter) is not needed.
    testImplementation("org.testcontainers:testcontainers-kafka:2.0.5")
    // The upstream kora-examples Kafka projects instead use the wrapper
    //   testImplementation("io.goodforgod:testcontainers-extensions-kafka:0.15.0")
    // Either works; this template drives the container directly to keep the test self-contained.

    // Only for tests that drive a suspend publisher method (runTest)
    testImplementation("org.jetbrains.kotlinx:kotlinx-coroutines-test:1.10.2")
}

kotlin {
    jvmToolchain {
        languageVersion.set(JavaLanguageVersion.of(25))
        vendor.set(JvmVendorSpec.ADOPTIUM)
    }
}

application {
    applicationName = "application"
    // A top-level `fun main()` in Application.kt compiles into <packagePath>.ApplicationKt
    mainClass.set("${packagePath}.ApplicationKt")
    applicationDefaultJvmArgs = listOf("-Dfile.encoding=UTF-8")
}

tasks.withType<JavaExec>().configureEach {
    environment("KAFKA_BOOTSTRAP_SERVERS", "localhost:9092")
}

tasks.test {
    useJUnitPlatform()
    testLogging {
        events("passed", "skipped", "failed")
        showStandardStreams = true
        exceptionFormat = org.gradle.api.tasks.testing.logging.TestExceptionFormat.FULL
    }
}
