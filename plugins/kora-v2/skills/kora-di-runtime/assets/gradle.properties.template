# Kora version, referenced as $koraVersion by the build scripts.
# 2.0.0.RC2 is published on Maven Central, so plain mavenCentral() is enough.
# Check for a newer 2.x before pinning.
#
# Do NOT put 2.0.0-SNAPSHOT here: that is the framework's own master development line, it is
# not on Central, and it would additionally require
#   maven { url = "https://central.sonatype.com/repository/maven-snapshots" }
# or a local publishToMavenLocal. Pin a release for anything you intend to run.
koraVersion=2.0.0.RC2
junitVersion=6.1.3

# JDK toolchain auto-detection / download (works with the foojay resolver).
# NOTE: this only controls the compile/test toolchain. The JDK that runs the
# Gradle process itself must be 25+ as well - set it via JAVA_HOME, not here.
org.gradle.java.installations.auto-detect=true
org.gradle.java.installations.auto-download=true

# Gradle build performance.
org.gradle.daemon=true
org.gradle.parallel=true
org.gradle.caching=true

org.gradle.jvmargs=-Dfile.encoding=UTF-8 -Xmx2g
