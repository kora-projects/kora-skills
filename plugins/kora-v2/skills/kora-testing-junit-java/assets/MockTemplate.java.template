package ${package};

/**
 * Mockito pattern catalog for Kora 2.0 JUnit 5 tests.
 *
 * Copy the pattern you need into a real @KoraAppTest class. Everything here is commented out on
 * purpose — this file is a reference, not a compilable test. If you do keep it in the source tree,
 * save it as MockTemplates.java so the file name matches the public class.
 *
 * Imports the patterns assume:
 *     import static org.mockito.ArgumentMatchers.*;
 *     import static org.mockito.Mockito.*;
 *     import static org.junit.jupiter.api.Assertions.*;
 *     import org.mockito.Mock;
 *     import org.mockito.Spy;
 *     import org.mockito.ArgumentCaptor;
 *     import org.mockito.quality.Strictness;
 *     import io.koraframework.test.extension.junit5.KoraAppTest;
 *     import io.koraframework.test.extension.junit5.TestComponent;
 *     import io.koraframework.test.extension.junit5.mockito.MockitoStrictness;
 *
 * Build:
 *     testImplementation "org.mockito:mockito-core:5.24.0"
 * An older mockito-core carries a Byte Buddy that rejects Kora 2.0's Java 25 class files with
 * "Java 25 (69) is not supported by the current version of Byte Buddy" — and when the mock is
 * created during graph build, that hides inside "Application graph failed to initialize with N
 * errors" with no visible cause.
 *
 * Two rules that apply to every pattern below:
 * - @Mock / @Spy must sit next to @TestComponent, otherwise the extension ignores them and the
 *   field stays null.
 * - Never add @ExtendWith(MockitoExtension.class); @KoraAppTest owns creation, graph injection,
 *   reset and unused-stub reporting.
 */
public final class MockTemplates {

    private MockTemplates() {}

    // =================================================================
    // PATTERN 1: Mock a graph dependency
    // =================================================================
    /*
    @KoraAppTest(Application.class)
    class UserServiceTest {

        @Mock
        @TestComponent
        private UserRepository userRepository;   // replaces the node in the graph

        @TestComponent
        private UserService userService;         // the real service, built with the mock

        @Test
        void returnsUser() {
            when(userRepository.findById("1")).thenReturn(Optional.of(TEST_USER));

            assertEquals(Optional.of(TEST_USER), userService.getUser("1"));
            verify(userRepository).findById("1");
        }
    }
    */

    // =================================================================
    // PATTERN 2: Sequence of return values
    // =================================================================
    /*
    when(userRepository.findById("1"))
        .thenReturn(Optional.of(USER_1))
        .thenReturn(Optional.of(USER_2))
        .thenReturn(Optional.empty());
    */

    // =================================================================
    // PATTERN 3: Throwing
    // =================================================================
    /*
    when(userRepository.findById("999"))
        .thenThrow(new IllegalStateException("User not found: 999"));

    var exception = assertThrows(IllegalStateException.class, () -> userService.getUser("999"));
    assertEquals("User not found: 999", exception.getMessage());
    */

    // =================================================================
    // PATTERN 4: Answer computed from the arguments
    // =================================================================
    /*
    // echo back what was written — useful for caches and repositories that return the saved value
    when(petCache.put(anyLong(), any())).then(invocation -> invocation.getArguments()[1]);
    when(userRepository.save(any())).thenAnswer(invocation -> invocation.getArgument(0));
    */

    // =================================================================
    // PATTERN 5: Argument matchers
    // =================================================================
    /*
    when(userRepository.findByEmail(anyString())).thenReturn(Optional.of(GENERIC_USER));
    when(userRepository.findByEmail(eq("specific@test.com"))).thenReturn(Optional.of(SPECIFIC_USER));
    when(userRepository.findAllById(anyList())).thenReturn(List.of(TEST_USER));
    when(petCache.get(anyCollection())).thenReturn(Map.of());

    // once one argument uses a matcher, all of them must — wrap literals in eq(...)
    */

    // =================================================================
    // PATTERN 6: ArgumentCaptor
    // =================================================================
    /*
    @Test
    void savesTheRightUser() {
        userService.createUser(new UserRequest("John", "john@example.com"));

        var captor = ArgumentCaptor.forClass(User.class);
        verify(userRepository).save(captor.capture());

        assertEquals("john@example.com", captor.getValue().email());
    }
    */

    // =================================================================
    // PATTERN 7: void methods
    // =================================================================
    /*
    doNothing().when(emailService).send(anyString(), anyString());
    doThrow(new IllegalStateException("Failed"))
        .when(emailService).send(eq("invalid@test.com"), anyString());
    */

    // =================================================================
    // PATTERN 8: @Spy over the instance the graph builds
    // =================================================================
    /*
    @KoraAppTest(Application.class)
    class SpyGraphTest {

        @Spy
        @TestComponent
        private UserService userService;   // real component, real dependencies, selected overrides

        @Test
        void overridesOneMethod() {
            doReturn(Optional.of(TEST_USER)).when(userService).getUser(anyString());

            assertEquals(Optional.of(TEST_USER), userService.getUser("1"));
            verify(userService).getUser("1");
        }
    }
    */

    // =================================================================
    // PATTERN 9: @Spy over an instance you supply
    // =================================================================
    /*
    @Spy
    @TestComponent
    private Supplier<String> component1 = () -> "12345";   // node dependencies are dropped

    // Prefer doReturn/doThrow/doNothing on a spy: when(spy.method()) calls the real method while
    // stubbing it.
    */

    // =================================================================
    // PATTERN 10: verify counts and order
    // =================================================================
    /*
    verify(repository, times(3)).save(any());
    verify(repository, never()).delete(any());
    verify(repository, atLeastOnce()).findAll();
    verify(repository, atMost(5)).update(any());

    var inOrder = inOrder(repository);
    inOrder.verify(repository).save(any());
    inOrder.verify(repository).update(any());
    inOrder.verify(repository).delete(any());
    */

    // =================================================================
    // PATTERN 11: strictness
    // =================================================================
    /*
    // io.koraframework.test.extension.junit5.mockito.MockitoStrictness
    // Levels: LENIENT, WARN (default when the annotation is absent), STRICT_STUBS
    @MockitoStrictness(Strictness.STRICT_STUBS)
    @KoraAppTest(Application.class)
    class StrictTest {

        @Mock
        @TestComponent
        private UserRepository userRepository;

        // A stub nobody uses fails the test with UnnecessaryStubbingException.
        // Relax a single mock instead of the whole class with:
        //   @Mock(strictness = Mock.Strictness.LENIENT)
    }
    */

    // =================================================================
    // PATTERN 12: what NOT to write in Kora 2.0
    // =================================================================
    /*
    // Contracts are synchronous — there is no reactive or future wrapper to stub or unwrap.
    // WRONG: when(repo.findById("1")).thenReturn(Mono.just(user));
    // WRONG: when(repo.findById("1")).thenReturn(CompletableFuture.completedFuture(user));
    // WRONG: StepVerifier.create(service.getUser("1")).expectNext(user).verifyComplete();
    // RIGHT: when(repo.findById("1")).thenReturn(Optional.of(user));
    //        assertEquals(Optional.of(user), service.getUser("1"));
    */
}
