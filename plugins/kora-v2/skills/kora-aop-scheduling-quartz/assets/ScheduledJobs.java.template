// Kora 2.0 Quartz scheduled jobs — artifact io.koraframework:scheduling-quartz.
// Annotations live in io.koraframework.scheduling.quartz.annotation (ScheduleQuartzWithCron,
// ScheduleQuartzWithTrigger, DisallowConcurrentExecution, PersistJobDataAfterExecution).
// For fixed-rate / fixed-delay / run-once timers, and for cron with no extra dependency,
// use the sibling skill kora-aop-scheduling-jdk instead.
//
// The class may stay `final`: Kora generates a separate $ScheduledJobs_<method>_Job wrapper
// that holds a reference to this component and calls the method directly — it is not an AOP
// proxy. Only method-wrapping aspects (@Log, @Retryable, @Timeout) require a non-final class.
//
// Replace `com.example.app.jobs` with your package.

package com.example.app.jobs;

import io.koraframework.common.annotation.Component;
import io.koraframework.scheduling.quartz.annotation.DisallowConcurrentExecution;
import io.koraframework.scheduling.quartz.annotation.ScheduleQuartzWithCron;
import io.koraframework.scheduling.quartz.annotation.ScheduleQuartzWithTrigger;
import org.quartz.JobExecutionContext;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.time.Duration;
import java.time.Instant;

@Component
public final class ScheduledJobs {

    private static final Logger log = LoggerFactory.getLogger(ScheduledJobs.class);

    /**
     * Inline Quartz cron: 6 or 7 fields, exactly one of day-of-month / day-of-week must be `?`.
     * The literal is validated at compile time; `0 0 3 * * *` would not build.
     */
    @DisallowConcurrentExecution
    @ScheduleQuartzWithCron("0 0 3 * * ?")
    void nightlyReport() {
        log.info("Generating nightly report");
    }

    /**
     * Cron from configuration. The node may be a bare string or an object with a `cron` field;
     * the object form also accepts `enabled` (false = no triggers) and a per-job `telemetry` block. When `value` is omitted the
     * config node is required and a missing one fails the graph build.
     */
    @ScheduleQuartzWithCron(config = "jobs.hourly")
    void hourlyCheck() {
        log.info("Running hourly check");
    }

    /**
     * Custom trigger. The class passed to @ScheduleQuartzWithTrigger is a TAG: the graph must supply
     * an org.quartz.Trigger under @Tag(ScheduledJobs.class). Kora 1.x wrote
     * @ScheduleWithTrigger(@Tag(X.class)) — that no longer compiles, the attribute is Class<?>.
     * See the @KoraApp snippet at the bottom of this file.
     */
    @ScheduleQuartzWithTrigger(ScheduledJobs.class)
    void customTrigger() {
        log.info("Fired by the tagged Trigger");
    }

    /**
     * A scheduled method may take a single org.quartz.JobExecutionContext.
     * Contracts are synchronous: no suspend, no Mono/Flux/CompletionStage.
     *
     * On shutdown Kora waits scheduling.quartz.shutdownWait (30s) for running jobs, then
     * interrupts them (KoraQuartzJob is an InterruptableJob) and waits once more. Keep the run
     * below that budget with a deadline, and stop when the thread is interrupted.
     */
    @DisallowConcurrentExecution
    @ScheduleQuartzWithCron("0 */5 * * * ?")
    void boundedBatch(JobExecutionContext ctx) {
        var deadline = Instant.now().plus(Duration.ofSeconds(20));
        log.info("Batch fired at {}, next fire {}", ctx.getFireTime(), ctx.getNextFireTime());

        while (hasWork()) {
            if (Instant.now().isAfter(deadline) || Thread.currentThread().isInterrupted()) {
                log.info("Stopping early, resuming on the next fire");
                return;
            }
            processNext();
        }
    }

    private boolean hasWork() {
        return false;
    }

    private void processNext() {
    }
}

