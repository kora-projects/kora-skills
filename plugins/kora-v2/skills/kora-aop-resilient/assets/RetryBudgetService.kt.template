//       tokensInitial = 10        # default 10, <= tokensMax
//       minTokensPerSecond = 0.5  # default 0.0 — time-based refill
//     }
//   }
//   pricing { delay = "50ms", attempts = 2 }   # budget comes from the tagged factory, no block needed
// }
