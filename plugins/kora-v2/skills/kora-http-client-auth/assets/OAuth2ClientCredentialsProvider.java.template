package ${package};

import io.koraframework.common.annotation.Component;
import io.koraframework.http.client.common.auth.HttpClientTokenProvider;
import io.koraframework.http.client.common.request.HttpClientRequest;

import java.time.Duration;

/**
 * OAuth2 client-credentials token provider for service-to-service auth.
 *
 * <p>Requires: {@code TokenCache}, {@code OAuth2AuthClient}, {@code OAuth2Config}.</p>
 *
 * <p>Implements Kora's {@code HttpClientTokenProvider}
 * ({@code io.koraframework.http.client.common.auth}); do not declare a same-named interface of your
 * own, as it would not satisfy {@code BearerAuthHttpClientInterceptor}'s constructor.</p>
 *
 * <p>{@code getToken} is synchronous and blocks the calling virtual thread. That is the Kora 2.0
 * execution model — there is no {@code CompletionStage} here and no {@code Context} parameter.
 * Concurrency is handled by {@code TokenCache}, which serialises refreshes so a traffic burst
 * produces one token request.</p>
 *
 * <p>The token's lifetime comes from the issuer's {@code expires_in}; the cache refreshes 60s
 * ahead of it. Return the bare token — {@code BearerAuthHttpClientInterceptor} adds the
 * {@code "Bearer "} prefix, and so does an OpenAPI-generated {@code ApiSecurity} interceptor for
 * bearer/oauth2/openId schemes.</p>
 */
@Component
public final class OAuth2ClientCredentialsProvider implements HttpClientTokenProvider {

    private final TokenCache cache;
    private final OAuth2AuthClient authClient;
    private final OAuth2Config config;

    public OAuth2ClientCredentialsProvider(TokenCache cache, OAuth2AuthClient authClient, OAuth2Config config) {
        this.cache = cache;
        this.authClient = authClient;
        this.config = config;
    }

    @Override
    public String getToken(HttpClientRequest request) {
        return cache.getOrRefresh(() -> {
            var response = authClient.requestClientCredentialsToken(config.scopes());
            return TokenCache.Token.of(response.accessToken(), Duration.ofSeconds(response.expiresIn()));
        });
    }

    /** Call after a 401 so the next request re-fetches instead of resending a rejected token. */
    public void invalidate() {
        this.cache.invalidate();
    }
}
