// ============================================================================
// 4. CUSTOMISING THE LETTUCE CLIENT (optional)
//    Kora 1.x LettuceConfigurator does not exist in 2.0. Each hook is a separate
//    io.koraframework.common.Configurer<T> component tagged @Tag(Tag.Factory.class).
// ============================================================================

package com.example.app.cache;

import io.koraframework.common.Configurer;
import io.koraframework.common.annotation.Component;
import io.koraframework.common.annotation.Tag;
// import io.lettuce.core.ClientOptions;                        // for the commented variant below
// import io.lettuce.core.cluster.ClusterClientOptions;         // for the commented variant below
import io.lettuce.core.resource.DefaultClientResources;

@Component
@Tag(Tag.Factory.class)
public final class RedisClientResourcesConfigurer implements Configurer<DefaultClientResources.Builder> {

    @Override
    public DefaultClientResources.Builder configure(DefaultClientResources.Builder builder) {
        return builder.ioThreadPoolSize(4);
    }
}

