// ============================================================================
// 2. APPLICATION GRAPH (Application.java)
// ============================================================================

package com.example.app;

import io.koraframework.application.graph.KoraApplication;
import io.koraframework.cache.caffeine.CaffeineCacheModule;
import io.koraframework.cache.redis.lettuce.LettuceRedisCacheModule;
import io.koraframework.common.annotation.KoraApp;
import io.koraframework.config.hocon.HoconConfigModule;
import io.koraframework.json.common.JsonModule;
import io.koraframework.logging.logback.LogbackModule;

@KoraApp
public interface Application extends
        HoconConfigModule,
        LogbackModule,
        JsonModule,                  // only needed for @Json Redis cache values
        CaffeineCacheModule,         // in-process caches
        LettuceRedisCacheModule {    // distributed caches — supplies the RedisCacheClient

    // Connect only the backend modules here. The per-cache `$XxxCache_Module` generated from each
    // @Cache interface is discovered automatically — listing it here is wrong.
    //
    // RedisCacheModule (cache-redis-common) is transport-neutral and supplies NO RedisCacheClient;
    // using it instead of LettuceRedisCacheModule fails the graph with
    //   No component found for dependency: io.koraframework.cache.redis.RedisCacheClient (no tags)

    static void main(String[] args) {
        KoraApplication.run(ApplicationGraph::graph);
    }
}


