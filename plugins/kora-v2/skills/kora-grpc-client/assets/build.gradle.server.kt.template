// Counterpart Kora 2.0 gRPC server — Gradle (Kotlin DSL).
// The authoritative server guidance is the kora-grpc-server skill; this exists so the client
// templates have something to talk to locally.
//
// Same version rule as the client: kora-bom constrains io.koraframework:* only, so every
// io.grpc:* stays on 1.84.0, in main AND test — a mismatched
// grpc-inprocess/grpc-netty produces AbstractMethodError: ... 'buildClientTransportServers(List,
// MetricRecorder)' when the server is built.
import com.google.protobuf.gradle.id

plugins {
    id("org.jetbrains.kotlin.jvm") version "2.4.20"
    id("com.google.devtools.ksp") version "2.3.12"
    id("application")
    id("com.google.protobuf") version "0.10.0"
}

kotlin {
    jvmToolchain {
        languageVersion.set(JavaLanguageVersion.of(25))
        vendor.set(JvmVendorSpec.ADOPTIUM)
    }
}

java {
    toolchain {
        languageVersion.set(JavaLanguageVersion.of(25))
        vendor.set(JvmVendorSpec.ADOPTIUM)
    }
}

// koraVersion lives in gradle.properties (koraVersion=2.0.0.RC2, plain mavenCentral() —
// no snapshot repository needed). Bound to a local so the declarations below stay readable.
val koraVersion: String by project

dependencies {
    implementation(platform("io.koraframework:kora-bom:$koraVersion"))
    ksp("io.koraframework:symbol-processors:$koraVersion")

    implementation("io.koraframework:grpc-server")
    implementation("io.koraframework:config-hocon")
    implementation("io.koraframework:logging-logback")

    implementation("io.grpc:grpc-protobuf:1.84.0")
    compileOnly("javax.annotation:javax.annotation-api:1.3.2")

    // Required for grpcServer.reflectionEnabled = true; the server probes for
    // io.grpc.protobuf.services.ProtoReflectionServiceV1 and silently skips reflection without it.
    // implementation("io.grpc:grpc-services:1.84.0")

    testImplementation("io.koraframework:test-junit5")
    testImplementation("io.grpc:grpc-inprocess:1.84.0")
}

application {
    applicationName = "application"
    mainClass.set("${package}.ApplicationKt")
    applicationDefaultJvmArgs = listOf("-Dfile.encoding=UTF-8")
}

protobuf {
    // protoc 3.25.3 matches the protobuf-java 3.25.9 that io.grpc:grpc-protobuf:1.84.0 brings in
    // transitively, so the runtime is never older than the generated code and no override is needed.
    // All eight migrated Kora gRPC projects pin this version.
    //
    // Optional upgrade — protoc 4.36.2 is what Kora itself builds with, and it works, but ONLY as a
    // PAIR. protoc 4.x generated code references com.google.protobuf.Generated, which does not exist
    // in protobuf-java 3.25.9, so taking the protoc line without the runtime line fails with
    // "cannot find symbol: class Generated / location: package com.google.protobuf":
    //     protoc { artifact = "com.google.protobuf:protoc:4.36.2" }
    //     implementation("com.google.protobuf:protobuf-java:4.36.2")  // must outrank the transitive 3.25.9
    protoc { artifact = "com.google.protobuf:protoc:3.25.3" }
    plugins {
        id("grpc") { artifact = "io.grpc:protoc-gen-grpc-java:1.84.0" }
    }
    generateProtoTasks {
        all().forEach { task -> task.plugins { id("grpc") } }
    }
}

// protoc-gen-grpc-java emits JAVA sources — they belong on the java source set even here.
sourceSets.main {
    java.srcDir(layout.buildDirectory.dir("generated/source/proto/main/grpc"))
    java.srcDir(layout.buildDirectory.dir("generated/source/proto/main/java"))
}

tasks.test {
    dependsOn("generateProto")
    useJUnitPlatform()
}

// Makes the gRPC alignment above enforceable instead of advisory: no transitive dependency can drag
// a test transport onto a different grpc-java line. protobuf is deliberately NOT forced here —
// protobuf-java resolves transitively from grpc-protobuf, so the two can never disagree, and pinning
// it would only fight that. grpc-kotlin has its own version line (1.5.0) and is excluded by name.
configurations.configureEach {
    resolutionStrategy.eachDependency {
        if (requested.group == "io.grpc" && !requested.name.contains("kotlin")) {
            useVersion("1.84.0")
        }
    }
}
