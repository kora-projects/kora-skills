// Kora 2.0 tracing dependencies (Gradle Groovy DSL).
//
// gradle.properties:  koraVersion=2.0.0.RC2
// repositories:       mavenCentral() -- 2.0.0.RC2 is a normal release, no snapshot repo needed.
// Every io.koraframework:* artifact is versioned by the BOM; never pin one yourself.

configurations {
    // The koraBom configuration comes from the project skeleton -- see kora-project-setup-java.
    // Repeated here so this snippet is usable on its own.
    koraBom
    annotationProcessor.extendsFrom(koraBom); compileOnly.extendsFrom(koraBom); implementation.extendsFrom(koraBom)
    api.extendsFrom(koraBom); testImplementation.extendsFrom(koraBom); testAnnotationProcessor.extendsFrom(koraBom)
}

dependencies {
    koraBom platform("io.koraframework:kora-bom:$koraVersion")
    annotationProcessor "io.koraframework:annotation-processors"

    // Pick ONE exporter. The wire protocol is the artifact, never a config key.

    // OTLP/gRPC -> tracing.exporter.endpoint = http://collector:4317
    // Sends over OkHttp (okhttp-jvm + okio are pulled in).
    implementation "io.koraframework:opentelemetry-tracing-exporter-grpc"

    // OTLP/HTTP -> tracing.exporter.endpoint = http://collector:4318/v1/traces
    // Sends over the JDK HTTP client; excludes the OkHttp sender entirely.
    // implementation "io.koraframework:opentelemetry-tracing-exporter-http"

    // Tracer + KoraTracer with no exporter: spans and trace ids in logs, nothing shipped.
    // implementation "io.koraframework:opentelemetry-tracing"

    // Optional. Supplies the MeterProvider that instruments the OTLP exporter and the
    // BatchSpanProcessor with their own queue/export metrics.
    // implementation "io.koraframework:micrometer-module"
}

// The OpenTelemetry API (Tracer, Span, SpanKind, StatusCode), the SDK trace package (Sampler)
// and the semantic conventions arrive transitively -- do not add io.opentelemetry:* by hand.

