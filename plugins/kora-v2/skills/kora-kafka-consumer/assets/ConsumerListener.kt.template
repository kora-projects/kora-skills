package ${packagePath}.listener

import io.koraframework.common.annotation.Component
import io.koraframework.kafka.common.annotation.KafkaListener
import io.koraframework.kafka.common.exceptions.KafkaSkipRecordException
import org.apache.kafka.clients.consumer.ConsumerRecord
import org.slf4j.LoggerFactory
import java.util.concurrent.atomic.AtomicInteger

/**
 * Kafka consumer for topics: ${topics}
 *
 * Config path: kafka.consumer.${listenerNameLower}
 *
 * ONE @KafkaListener function per config path. Every additional @KafkaListener on the same path
 * starts an additional consumer sharing the same group — give each listener its own section.
 *
 * Listener functions are plain `fun`, never `suspend`: Kora 2.0 contracts are synchronous and run
 * on the poll thread. Other accepted signatures (references/kafka-listener-reference.md):
 *
 *   fun process(value: String)
 *   fun process(key: String, value: String)
 *   fun process(key: String, value: String, headers: Headers)
 *   fun process(records: ConsumerRecords<K, V>)                  // whole poll batch
 *   fun process(record: ConsumerRecord<K, V>, consumer: Consumer<K, V>)   // you commit
 *   fun process(value: String?, exception: Exception?)           // deserialization errors
 *   fun process(key: String?, value: String?, headers: Headers, exception: Exception?)
 */
@Component
class ${listenerName} {

    private val log = LoggerFactory.getLogger(${listenerName}::class.java)

    private val processed = AtomicInteger()
    private val skipped = AtomicInteger()

    @KafkaListener("kafka.consumer.${listenerNameLower}")
    fun process(record: ConsumerRecord<String, String>) {
        // Lazy deserialization: value() throws RecordValueDeserializationException on bad payloads.
        val value = record.value()

        if (value.isNullOrBlank()) {
            skipped.incrementAndGet()
            // Reported to telemetry, offset committed, next record processed.
            throw KafkaSkipRecordException(
                IllegalArgumentException(
                    "Blank payload at " + record.topic() + "-" + record.partition() + "@" + record.offset()
                )
            )
        }

        log.debug("Consuming {}-{}@{}", record.topic(), record.partition(), record.offset())
        handle(value)
        processed.incrementAndGet()
    }

    private fun handle(value: String) {
        // TODO business logic — runs on the poll thread, keep it under max.poll.interval.ms
    }

    fun processedCount(): Int = processed.get()

    fun skippedCount(): Int = skipped.get()
}

/*
 * Manual commit variant — its own class, its own config section:
 *
 * @Component
 * class ${listenerName}ManualCommit(private val repository: OrderRepository) {
 *
 *     @KafkaListener("kafka.consumer.${listenerNameLower}Manual")
 *     fun process(record: ConsumerRecord<String, String>, consumer: Consumer<String, String>) {
 *         repository.insert(record.value())
 *         consumer.commitSync()
 *     }
 * }
 *
 * Rebalance callbacks — bind by tag (references/kafka-rebalance-reference.md):
 *
 * @Tag(${listenerName}Module.${listenerName}ProcessTag::class)
 * @Component
 * class ${listenerName}RebalanceListener : ConsumerAwareRebalanceListener {
 *     override fun onPartitionsRevoked(consumer: Consumer<*, *>, partitions: Collection<TopicPartition>) { }
 *     override fun onPartitionsAssigned(consumer: Consumer<*, *>, partitions: Collection<TopicPartition>) { }
 *     override fun onPartitionsLost(consumer: Consumer<*, *>, partitions: Collection<TopicPartition>) { }
 * }
 */
