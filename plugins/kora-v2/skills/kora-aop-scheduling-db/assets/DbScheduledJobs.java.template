// Kora 2.x database-backed scheduled jobs — artifact io.koraframework:scheduling-db-scheduler.
//
// Requires on the @KoraApp interface:  JdbcDatabaseModule, DbSchedulerModule (its KoraDbScheduler is @Root)
// Requires in the build:               annotationProcessor "io.koraframework:annotation-processors"
// Requires in the database:            the scheduler table (V2__create_kora_scheduling_db_scheduler_jobs.sql.template)
//
// Each firing runs on exactly one replica. `name` is the job's key in the table: keep it stable.
// Without `name` the key is CanonicalClassName#method, which changes when the class moves.
//
// Replace `com.example.app.jobs` with your package.

package com.example.app.jobs;

import io.koraframework.common.annotation.Component;
import io.koraframework.scheduling.db.scheduler.annotation.ScheduleDbOnce;
import io.koraframework.scheduling.db.scheduler.annotation.ScheduleDbWithCron;
import io.koraframework.scheduling.db.scheduler.annotation.ScheduleDbWithFixedDelay;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.time.temporal.ChronoUnit;

@Component
public final class DbScheduledJobs {

    private static final Logger log = LoggerFactory.getLogger(DbScheduledJobs.class);

    /**
     * Cron — Spring-style six fields (seconds first, day-of-week 1 = Monday), checked at compile time.
     * Time zone: a @Tag(SchedulingModule.class) ZoneId component, else the JVM default.
     * Config may override it: scheduling.jobs.cleanup = "0 30 2 * * *", "-" or { enabled = false } to disable.
     */
    @ScheduleDbWithCron(value = "0 0 2 * * *", name = "nightly-cleanup", config = "scheduling.jobs.cleanup")
    void cleanup() {
        log.info("nightly cleanup");
    }

    /**
     * Fixed delay — next run is `delay` after the previous one completed, on whichever replica picks it.
     * `initialDelay` applies only when the job's row is first created.
     */
    @ScheduleDbWithFixedDelay(initialDelay = 30, delay = 60, unit = ChronoUnit.SECONDS, name = "outbox-relay")
    void relayOutbox() {
        log.debug("relaying outbox");
    }

    /**
     * One shot — scheduled on startup when none is pending, removed after it runs, never retried.
     */
    @ScheduleDbOnce(delay = 1, unit = ChronoUnit.MINUTES, name = "cache-warmup")
    void warmup() {
        log.info("warming caches");
    }
}
